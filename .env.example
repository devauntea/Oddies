# Copy to .env for local dev. Never commit .env.
# Or keep the keys in the macOS keychain instead: scripts/keys.sh add
# On Fly these are set with `fly secrets set`, see the README.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NIMBLE_API_KEY=
SENTRY_DSN=

# Optional
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low
PORT=3000
