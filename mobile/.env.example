# Copy to `.env.local` (git-ignored) and fill in.

# Server-only. Used by the Expo API routes in src/app/api. Never prefix with EXPO_PUBLIC_,
# which would bundle it into the mobile app. Leave empty to run with mock research data.
NIMBLE_API_KEY=

# Optional. Base URL of the deployed API routes (e.g. your EAS Hosting URL) for
# production/preview builds. In development the app talks to the Metro dev server.
EXPO_PUBLIC_API_URL=

# Sentry (https://sentry.io). The DSN is public by design; leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=
# Set to "true" to also report from `npm start` builds while debugging Sentry itself.
EXPO_PUBLIC_SENTRY_IN_DEV=

# Build-time only, SECRET: lets EAS builds upload source maps so stack traces are readable.
# Set these as EAS secrets, never commit them and never prefix them with EXPO_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
